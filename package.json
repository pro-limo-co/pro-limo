{
  "name": "pro-limo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:vercel": "npx convex env set SITE_URL \"$SITE_URL\" && npx convex env set NEXT_PUBLIC_SITE_URL \"$NEXT_PUBLIC_SITE_URL\" && npx convex env set BETTER_AUTH_SECRET \"$BETTER_AUTH_SECRET\" && npx convex env set DISPATCH_ADMIN_EMAILS \"$DISPATCH_ADMIN_EMAILS\" && npx convex deploy --cmd \"npm run build\"",
    "start": "next start",
    "lint": "eslint",
    "doctor:react": "react-doctor . --verbose --full --offline --project pro-limo",
    "doctor:react:score": "react-doctor . --score --full --offline --project pro-limo",
    "smoke:prod": "node scripts/smoke-prod.mjs"
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.12.4",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/nextjs": "^10.58.0",
    "@vis.gl/react-google-maps": "^1.8.3",
    "better-auth": "^1.6.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.41.0",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.6.0",
    "ts-maps": "^0.2.7"
  },
