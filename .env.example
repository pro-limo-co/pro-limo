# Public site URLs used by Better Auth redirects and Stripe checkout URLs.
SITE_URL=https://prolimodriver.com
NEXT_PUBLIC_SITE_URL=https://prolimodriver.com

# Better Auth.
BETTER_AUTH_SECRET=
DISPATCH_ADMIN_EMAILS=

# Stripe payment scaffold.
